<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/showData"
    android:background="@drawable/login1_bk"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".MainActivity2">
    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar"
        android:background="@color/appcolor"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        app:navigationIcon="?attr/homeAsUpIndicator"
        >
   <LinearLayout
       android:layout_width="match_parent"
       android:orientation="horizontal"
       android:layout_height="wrap_content">

       <TextView
           android:layout_width="wrap_content"
           android:layout_height="65dp"
           android:gravity="left|center"
           android:padding="5dp"
           android:textSize="25dp"
           android:text="Add todays data"
           app:layout_constraintTop_toTopOf="parent"/>
       <androidx.appcompat.widget.AppCompatButton
           android:id="@+id/log_out"
           android:layout_width="wrap_content"
           android:layout_height="38dp"
           android:layout_marginStart="80dp"
           android:layout_marginEnd="4dp"
           android:drawableRight="@drawable/logout"
           android:backgroundTint="@color/appcolor"
           android:drawablePadding="5dp"
           app:layout_constraintTop_toTopOf="parent"
           tools:layout_editor_absoluteX="3dp" />
   </LinearLayout></androidx.appcompat.widget.Toolbar>
    <ProgressBar
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:visibility="gone"
        android:layout_gravity="center"
        android:id="@+id/progress" />

    <TextView
        android:id="@+id/name"
        android:layout_width="410dp"
        android:drawablePadding="5dp"
        android:layout_height="71dp"
        android:layout_marginTop="128dp"
        android:drawableLeft="@android:drawable/ic_lock_idle_alarm"
        android:inputType="date"
        android:gravity="left|center"
        android:hint="DD/MM/Year"
        android:textColorHint="@color/appcolor"
        android:textSize="20dp" />

    <View
        android:layout_width="match_parent"
        android:background="@color/black"
        android:layout_height="1dp" />
<EditText
        android:id="@+id/age"
        android:layout_width="410dp"
        android:layout_height="71dp"
        android:inputType="numberDecimal"
        android:hint="Your Today's BMI"
    android:drawableLeft="@drawable/icons"
    android:drawablePadding="5dp"
        android:textColorHint="@color/appcolor"
        app:layout_constraintTop_toTopOf="parent"
        tools:layout_editor_absoluteX="-2dp"/>

    <TextView
        android:layout_width="410dp"
        android:layout_height="wrap_content"
        android:id="@+id/BMI_CAL"
        android:hint="Don't Know BMI??"
        app:layout_constraintTop_toTopOf="parent"
        tools:layout_editor_absoluteX="1dp" />

    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/save"
        android:layout_width="wrap_content"
        android:layout_gravity="center"
        android:layout_height="48dp"
        android:text="save"
        android:layout_marginTop="20dp"
        android:textColor="@color/white"
        android:background="@color/appcolor"
        app:layout_constraintBottom_toBottomOf="parent"
        tools:layout_editor_absoluteX="-1dp" />
    <androidx.cardview.widget.CardView
        android:layout_width="120dp"
        android:layout_height="100dp"
        android:id="@+id/card"
        app:cardCornerRadius="14dp"
        android:layout_margin="5dp"
        android:visibility="gone"
        android:layout_gravity="center_horizontal"
        android:backgroundTint="@color/pinkcolor">

        <EditText
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:id="@+id/weight"
            android:textSize="10dp"
            android:inputType="numberDecimal"
            android:hint="Weght in kg" />

        <EditText
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:id="@+id/height"
            android:layout_gravity="center_vertical"
            android:textSize="10dp"
            android:inputType="numberDecimal"
            android:hint="Heght in meter"/>
        <androidx.appcompat.widget.AppCompatButton
            android:layout_width="match_parent"
            android:layout_height="15dp"
            android:id="@+id/cal"
            android:background="@color/white"
            android:text="Calculate"
            android:textSize="10sp"
            android:layout_gravity="bottom"
            ></androidx.appcompat.widget.AppCompatButton>
    </androidx.cardview.widget.CardView>

    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/show_data"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:textColor="@color/white"

        android:layout_marginTop="100dp"
        android:background="@color/appcolor"
        android:text="show_data"
        tools:layout_editor_absoluteX="3dp"/>


</LinearLayout>