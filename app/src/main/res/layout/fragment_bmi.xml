<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_fitness_gradient"
    android:fillViewport="true"
    tools:context=".ui.gallery.BmiFragment">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="18dp"
        android:paddingEnd="20dp"
        android:paddingBottom="24dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_bmi_hero"
            android:orientation="vertical"
            android:padding="22dp">

            <TextView
                android:id="@+id/text_gallery"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/bmi_fragment_title"
                android:textColor="@color/fitness_navy"
                android:textSize="28sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/bmi_fragment_subtitle"
                android:textColor="@color/fitness_navy"
                android:textSize="14sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:background="@drawable/bg_home_chip"
                android:paddingStart="12dp"
                android:paddingTop="8dp"
                android:paddingEnd="12dp"
                android:paddingBottom="8dp"
                android:text="Healthy range: 18.5 - 24.9"
                android:textColor="@color/fitness_text_primary"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>

        <ImageView
            android:layout_width="match_parent"
            android:layout_height="180dp"
            android:layout_marginTop="18dp"
            android:background="@drawable/bg_auth_panel"
            android:padding="10dp"
            android:scaleType="fitCenter"
            android:src="@drawable/bmichart" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:background="@drawable/bg_auth_panel"
            android:orientation="vertical"
            android:padding="20dp">

            <EditText
                android:id="@+id/weight"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_auth_input"
                android:hint="@string/your_weight_in_kg"
                android:inputType="numberDecimal"
                android:minHeight="56dp"
                android:paddingStart="16dp"
                android:paddingTop="16dp"
                android:paddingEnd="16dp"
                android:paddingBottom="16dp"
                android:textColor="@color/fitness_text_primary"
                android:textColorHint="@color/fitness_text_muted" />

            <EditText
                android:id="@+id/height"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:background="@drawable/bg_auth_input"
                android:hint="@string/your_height_in_meter"
                android:inputType="numberDecimal"
                android:minHeight="56dp"
                android:paddingStart="16dp"
                android:paddingTop="16dp"
                android:paddingEnd="16dp"
                android:paddingBottom="16dp"
                android:textColor="@color/fitness_text_primary"
                android:textColorHint="@color/fitness_text_muted" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/BMICalculate"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/calculate"
                android:textAllCaps="false"
                android:textColor="@color/fitness_text_primary"
                android:textStyle="bold"
                app:backgroundTint="@color/fitness_accent"
                app:cornerRadius="18dp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:background="@drawable/bg_bmi_result_card"
            android:orientation="vertical"
            android:padding="20dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Your BMI Result"
                android:textColor="@color/fitness_text_primary"
                android:textSize="22sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/result"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0.0"
                    android:textColor="@color/fitness_gold"
                    android:textSize="34sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:text="kg/m²"
                    android:textColor="@color/fitness_text_secondary"
                    android:textSize="16sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/Showtext"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/bmi_fragment_result_hint"
                android:textColor="@color/fitness_text_secondary"
                android:textSize="14sp" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
